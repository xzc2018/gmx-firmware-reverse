-- scorpion: нетлист схемы FPGA GMX "Scorpion" (EPF8452ALC84), одна ячейка на узел.
-- Узел lcK_<ряд><столбец> соответствует ячейке LCK_<РЯД><столбец>.
SUBDESIGN scorpion
(
	G : OUTPUT;	-- pin 1 (G)
	DB7 : BIDIR;	-- pin 2 (DB7)
	R : OUTPUT;	-- pin 3 (R)
	DB6 : BIDIR;	-- pin 4 (DB6)
	DB5 : BIDIR;	-- pin 6 (DB5)
	DB4 : BIDIR;	-- pin 7 (DB4)
	DB3 : BIDIR;	-- pin 8 (DB3)
	DB2 : BIDIR;	-- pin 9 (DB2)
	p14M : INPUT;	-- pin 12 (14M)
	DB1 : BIDIR;	-- pin 13 (DB1)
	DB0 : BIDIR;	-- pin 14 (DB0)
	MA0 : OUTPUT;	-- pin 15 (MA0)
	MA1 : OUTPUT;	-- pin 16 (MA1)
	MA2 : OUTPUT;	-- pin 18 (MA2)
	MA3 : OUTPUT;	-- pin 19 (MA3)
	MA4 : OUTPUT;	-- pin 20 (MA4)
	MA5 : OUTPUT;	-- pin 21 (MA5)
	MA6 : OUTPUT;	-- pin 22 (MA6)
	MA7 : OUTPUT;	-- pin 23 (MA7)
	MA8 : OUTPUT;	-- pin 24 (MA8)
	MA9 : OUTPUT;	-- pin 25 (MA9)
	RAS_n : OUTPUT;	-- pin 27 (RAS/)
	CAS0_n : OUTPUT;	-- pin 28 (CAS0/)
	CAS1 : OUTPUT;	-- pin 29 (CAS1)
	WE_n : OUTPUT;	-- pin 30 (WE/)
	MD1 : INPUT;	-- pin 31 (MD1)
	MD2 : INPUT;	-- pin 34 (MD2)
	MD3 : INPUT;	-- pin 35 (MD3)
	MD4 : INPUT;	-- pin 36 (MD4)
	MD5 : INPUT;	-- pin 37 (MD5)
	MD6 : INPUT;	-- pin 39 (MD6)
	MD0 : INPUT;	-- pin 40 (MD0)
	WAIT_n : OUTPUT;	-- pin 41 (WAIT/)
	RD_n : INPUT;	-- pin 42 (RD/)
	IORQ_n : INPUT;	-- pin 43 (IORQ/)
	M1 : INPUT;	-- pin 44 (M1)
	MG : INPUT;	-- pin 45 (MG)
	MREQ_n : INPUT;	-- pin 46 (MREQ/)
	RAM_n : OUTPUT;	-- pin 48 (RAM/)
	CLKCPU : OUTPUT;	-- pin 49 (CLKCPU)
	EBUF : OUTPUT;	-- pin 50 (EBUF)
	INT : OUTPUT;	-- pin 51 (INT)
	MD7 : INPUT;	-- pin 54 (MD7)
	TRBB : BIDIR;	-- pin 55 (TRBB)
	A15 : INPUT;	-- pin 56 (A15)
	A14 : INPUT;	-- pin 57 (A14)
	WRBUF : OUTPUT;	-- pin 58 (WRBUF)
	A12 : INPUT;	-- pin 60 (A12)
	A11 : INPUT;	-- pin 61 (A11)
	A10 : INPUT;	-- pin 62 (A10)
	A9 : INPUT;	-- pin 63 (A9)
	A8 : INPUT;	-- pin 64 (A8)
	A7 : INPUT;	-- pin 65 (A7)
	A6 : INPUT;	-- pin 66 (A6)
	A5 : INPUT;	-- pin 67 (A5)
	A4 : INPUT;	-- pin 69 (A4)
	A3 : INPUT;	-- pin 70 (A3)
	A2 : INPUT;	-- pin 71 (A2)
	A1 : INPUT;	-- pin 72 (A1)
	RESET : INPUT;	-- pin 73 (RESET)
	A0 : INPUT;	-- pin 76 (A0)
	A13 : INPUT;	-- pin 77 (A13)
	RDR_n : OUTPUT;	-- pin 78 (RDR/)
	WROUT_n : OUTPUT;	-- pin 79 (WROUT/)
	VS : OUTPUT;	-- pin 81 (VS)
	SYNC : OUTPUT;	-- pin 82 (SYNC)
	I : OUTPUT;	-- pin 83 (I)
	B : OUTPUT	-- pin 84 (B)
)
VARIABLE
	DB7_tri : TRI;
	DB6_tri : TRI;
	DB5_tri : TRI;
	DB4_tri : TRI;
	DB3_tri : TRI;
	DB2_tri : TRI;
	DB1_tri : TRI;
	DB0_tri : TRI;
	TRBB_tri : TRI;
	lc1_a1 : DFF;
	lc2_a1 : LCELL;
	lc3_a1 : DFF;
	lc4_a1 : DFF;
	lc5_a1 : DFF;
	lc6_a1 : DFF;
