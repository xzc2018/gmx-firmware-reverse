	lc8_b19 : DFF;
	lc1_b20 : DFF;
	lc2_b20 : LCELL;
	lc3_b20 : DFF;
	lc4_b20 : LCELL;
	lc5_b20 : LCELL;
	lc6_b20 : LCELL;
	lc7_b20 : DFF;
	lc8_b20 : LCELL;
	lc1_b21 : LCELL;
	lc2_b21 : DFF;
	lc3_b21 : LCELL;
	lc4_b21 : DFF;
	lc5_b21 : LCELL;
	lc6_b21 : LCELL;
	lc7_b21 : LCELL;
BEGIN
	G = lc1_b11;	-- pin 1 VIO40, slow slew
	DB7_tri.in = lc1_a10;
	DB7_tri.oe = lc1_b2;	-- OE via peripheral line POE1
	DB7 = DB7_tri.out;	-- pin 2 VIO36, slow slew
	R = lc1_b8;	-- pin 3 VIO28, slow slew
	DB6_tri.in = lc1_b7;
	DB6_tri.oe = lc1_b2;	-- OE via peripheral line POE1
	DB6 = DB6_tri.out;	-- pin 4 VIO24, slow slew
	DB5_tri.in = lc1_a6;
	DB5_tri.oe = lc1_b2;	-- OE via peripheral line POE1
	DB5 = DB5_tri.out;	-- pin 6 VIO20, slow slew
	DB4_tri.in = lc1_a4;
	DB4_tri.oe = lc1_b2;	-- OE via peripheral line POE1
	DB4 = DB4_tri.out;	-- pin 7 VIO12, slow slew
	DB3_tri.in = lc1_b3;
	DB3_tri.oe = lc1_b2;	-- OE via peripheral line POE1
	DB3 = DB3_tri.out;	-- pin 8 VIO8, slow slew
	DB2_tri.in = lc3_b2;
	DB2_tri.oe = lc1_b2;	-- OE via peripheral line POE1
	DB2 = DB2_tri.out;	-- pin 9 VIO4, slow slew
	DB1_tri.in = lc1_a21;
	DB1_tri.oe = lc1_b2;	-- OE via peripheral line POE1
	DB1 = DB1_tri.out;	-- pin 13 HIO0, slow slew
	DB0_tri.in = lc2_a17;
	DB0_tri.oe = lc1_b2;	-- OE via peripheral line POE1
	DB0 = DB0_tri.out;	-- pin 14 HIO2, slow slew
	MA0 = lc4_a14;	-- pin 15 HIO4, slow slew
	MA1 = lc2_a7;	-- pin 16 HIO6, slow slew
	MA2 = lc8_a16;	-- pin 18 HIO8, slow slew
	MA3 = lc6_a16;	-- pin 19 HIO10, slow slew
	MA4 = lc5_a5;	-- pin 20 HIO12, slow slew
	MA5 = lc8_a14;	-- pin 21 HIO14, slow slew
	MA6 = lc2_b15;	-- pin 22 HIO16, slow slew
	MA7 = lc2_b5;	-- pin 23 HIO18, slow slew
	MA8 = lc4_b1;	-- pin 24 HIO20, slow slew
	MA9 = lc2_b1;	-- pin 25 HIO22, slow slew
	RAS_n = lc6_b19;	-- pin 27 HIO24, slow slew
	CAS0_n = lc5_b10;	-- pin 28 HIO26, slow slew
	CAS1 = lc5_b20;	-- pin 29 HIO28, slow slew
	WE_n = !lc8_b10;	-- pin 30 HIO30, slow slew
	WAIT_n = lc8_b9;	-- pin 41 VIO35, slow slew
	RAM_n = !lc1_b17;	-- pin 48 VIO67, slow slew
	CLKCPU = !lc4_b19;	-- pin 49 VIO75, slow slew
	EBUF = lc2_b20;	-- pin 50 VIO79, slow slew
	INT = !lc2_b21;	-- pin 51 VIO83, slow slew
	TRBB_tri.in = lc8_b19;
	TRBB_tri.oe = lc1_b21;	-- OE via peripheral line PCLK1
	TRBB = TRBB_tri.out;	-- pin 55 HIO31, slow slew
	WRBUF = !lc8_b20;	-- pin 58 HIO25, slow slew
	RDR_n = lc2_a19;	-- pin 78 VIO72, slow slew
	WROUT_n = lc1_a18;	-- pin 79 VIO68, slow slew
	VS = !lc1_b16;	-- pin 81 VIO60, slow slew
	SYNC = lc1_b15;	-- pin 82 VIO56, slow slew
	I = lc1_b14;	-- pin 83 VIO52, slow slew
	B = lc1_b12;	-- pin 84 VIO44, slow slew
	-- LC1_A1 LUT AAAA
	lc1_a1.d = MD1;
	lc1_a1.clk = !lc3_b20;
	-- LC2_A1 LUT CFC0
	lc2_a1 = (lc1_a1 & lc2_a8)
		# (!lc2_a8 & lc8_a1);
	-- LC3_A1 LUT FC0C
	lc3_a1.d = (lc3_a1 & !lc3_b9)
		# (lc3_b9 & DB7);
	lc3_a1.clk = lc2_b12;
	lc3_a1.clrn = RESET;
	-- LC4_A1 LUT FC0C
	lc4_a1.d = (lc4_a1 & !lc3_b9)
		# (lc3_b9 & DB6);
	lc4_a1.clk = lc2_b12;
	lc4_a1.clrn = RESET;
	-- LC5_A1 LUT AAAA
	lc5_a1.d = MD5;
	lc5_a1.clk = !lc3_b20;
	-- LC6_A1 LUT AAAA
	lc6_a1.d = MD0;
	lc6_a1.clk = !lc3_b20;
	-- LC7_A1 LUT AAAA
	lc7_a1.d = MD4;
	lc7_a1.clk = !lc3_b20;
	-- LC8_A1 LUT F0CC
	lc8_a1 = (lc5_a3 & !lc4_a4)
		# (lc8_a1 & lc4_a4);
	-- LC1_A2 LUT BFFF
	lc1_a2 = !lc5_a11
		# !lc4_a13
		# !lc8_a21
		# lc6_a11;
	-- LC2_A2 LUT CFC0
	lc2_a2 = (lc4_b9 & lc5_b14)
		# (!lc5_b14 & lc5_a2);
	-- LC3_A2 LUT CFC0
	lc3_a2 = (A7 & lc5_b14)
		# (!lc5_b14 & lc6_a2);
	-- LC4_A2 LUT BFFF
	lc4_a2 = !lc8_a9
		# !lc3_a8
		# !lc8_a2
		# lc1_a2;
	-- LC5_A2 LUT FC0C
	lc5_a2 = (lc5_b13 & !lc6_a10)
		# (lc6_a10 & lc5_a11);
	-- LC6_A2 LUT FC0C
	lc6_a2 = (lc5_b16 & !lc6_a10)
		# (lc6_a10 & lc8_a21);
	-- LC7_A2 LUT 3033
	lc7_a2 = (!lc4_a12 & !lc1_b16)
		# (!lc4_a12 & lc6_a18);
	-- LC8_A2 LUT 00FF
	lc8_a2.d = !lc8_a2;
	lc8_a2.clk = lc1_a2;
	lc8_a2.clrn = lc7_a2;
	lc8_a2.prn = lc3_a11;
	-- LC1_A3 LUT 00FF
	lc1_a3.d = !lc1_a3;
	lc1_a3.clk = lc5_a6;
	-- LC3_A3 LUT FC0C
	lc3_a3.d = (lc3_a3 & !lc7_b9)
		# (lc7_b9 & DB1);
	lc3_a3.clk = lc2_b12;
	lc3_a3.clrn = RESET;
	-- LC4_A3 LUT CFC0
	lc4_a3.d = (lc4_a3 & lc5_a21)
		# (!lc5_a21 & DB5);
	lc4_a3.clk = lc2_b12;
	lc4_a3.clrn = RESET;
	-- LC5_A3 LUT F3C0
	lc5_a3.d = (lc5_a21 & lc5_a3)
		# (!lc5_a21 & DB1);
	lc5_a3.clk = lc2_b12;
	lc5_a3.clrn = RESET;
	-- LC6_A3 LUT FC0C
	lc6_a3.d = (lc6_a3 & !lc7_b9)
		# (lc7_b9 & DB5);
	lc6_a3.clk = lc2_b12;
	lc6_a3.clrn = RESET;
	-- LC7_A3 LUT FC0C
	lc7_a3.d = (lc7_a3 & !lc3_b9)
		# (lc3_b9 & DB5);
