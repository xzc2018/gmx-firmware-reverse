-- magic: Кнопка Magic, флаг TR-DOS (включение при выборке из 3Dxx), защёлки конфигурации для чтения
-- Схема GMX "Scorpion", FPGA EPF8452ALC84.
SUBDESIGN magic
(
	A[15..0],
	M1,
	MG,
	MREQ_n,
	RESET,
	turbo,
	a9_buf,
	rd_ff,
	sys[3..0],
	scr,
	rom1,
	blkpk1,
	blk1,
	sm[2..0],
	mag_dis,
	graphic,
	ram_sel,
	rom_rd_n,
	m1_ram	: INPUT;
	o_magic_hold,
	o_dos_act,
	o_ml_sys[3..0],
	o_ml_sm[2..0],
	o_ml_blkpk1,
	o_ml_scr,
	o_ml_turbo,
	o_ml_gfx,
	o_ml_blk1	: OUTPUT;
)
VARIABLE
	magic_act         : DFFE;	-- Magic принята (MG нажата и не запрещена), фиксируется по M1 из ОЗУ
	magic_hold        : DFF;	-- защёлки конфигурации заморожены (после Magic до чтения #FF)
	magic_rel         : LCELL;	-- снятие magic_hold: холостое чтение #FF (и RESET)
	dos_act           : DFF;	-- включено теневое ПЗУ (TR-DOS/монитор): включение при выборке из 3Dxx, выход по M1 из ОЗУ
	dos_trap_n        : DFF;	-- 0 = выборка команды из 3D00-3DFF при ПЗУ-48 (включение TR-DOS)
	a3dxx_m1_n        : LCELL;	-- 0 = M1 и A9=0, A8=1 (часть дешифратора 3Dxx)
	a13_10_n          : LCELL;	-- 0 = A13..A10 все 1 (адрес 3Cxx-3Fxx)
	ml_sys[3..0]      : LCELL;	-- защёлки SYS0..3 для чтения #7AFD (заморожены после Magic)
	ml_sm[2..0]       : LCELL;	-- защёлки SM0..2 для чтения #7AFD
	ml_blkpk1         : LCELL;	-- защёлка BLKPK1 для чтения #7EFD
	ml_scr            : LCELL;	-- защёлка SCR
	ml_turbo          : LCELL;	-- защёлка Турбо
	ml_gfx            : LCELL;	-- защёлка Graphic
	ml_blk1           : LCELL;	-- защёлка BLK1
BEGIN

	-- magic_act: Magic принята (MG нажата и не запрещена), фиксируется по M1 из ОЗУ
	magic_act.clk = m1_ram;
	magic_act.clrn = rom_rd_n;
	magic_act.ena = !mag_dis;
	magic_act.d = !MG;

	-- magic_hold: защёлки конфигурации заморожены (после Magic до чтения #FF)
	magic_hold.clk = magic_act;
	magic_hold.clrn = magic_rel;
	magic_hold.d = VCC;

	-- magic_rel: снятие magic_hold: холостое чтение #FF (и RESET)
	magic_rel = RESET & !rd_ff;

	-- dos_act: включено теневое ПЗУ (TR-DOS/монитор): включение при выборке из 3Dxx, выход по M1 из ОЗУ
	dos_act.clk = m1_ram;
	dos_act.clrn = RESET;
	dos_act.prn = dos_trap_n;
	dos_act.d = magic_act;

	-- dos_trap_n: 0 = выборка команды из 3D00-3DFF при ПЗУ-48 (включение TR-DOS)
	dos_trap_n.clk = !MREQ_n;
	IF !a3dxx_m1_n & !ram_sel & rom1 THEN dos_trap_n.d = a13_10_n; ELSE dos_trap_n.d = VCC; END IF;

	-- a3dxx_m1_n: 0 = M1 и A9=0, A8=1 (часть дешифратора 3Dxx)
	a3dxx_m1_n = !A8
		# a9_buf
		# M1;

	-- a13_10_n: 0 = A13..A10 все 1 (адрес 3Cxx-3Fxx)
	a13_10_n = !A10
		# !A13
		# !A11
		# !A12;

	-- ml_sys[3..0]: защёлки SYS0..3 для чтения #7AFD (заморожены после Magic)
	--   ml_sys3: защёлка SYS3
	--   ml_sys2: защёлка SYS2
	--   ml_sys1: защёлка SYS1
	--   ml_sys0: защёлка SYS0 для чтения #7AFD
	IF magic_hold THEN
		ml_sys[] = ml_sys[];
	ELSE
		ml_sys[] = sys[];
	END IF;

	-- ml_sm[2..0]: защёлки SM0..2 для чтения #7AFD
	--   ml_sm2: защёлка SM2
	--   ml_sm1: защёлка SM1
	--   ml_sm0: защёлка SM0
	IF magic_hold THEN
		ml_sm[] = ml_sm[];
	ELSE
		ml_sm[] = sm[];
	END IF;

	-- ml_blkpk1: защёлка BLKPK1 для чтения #7EFD
	IF !magic_hold THEN ml_blkpk1 = blkpk1; ELSE ml_blkpk1 = ml_blkpk1; END IF;

	-- ml_scr: защёлка SCR
	IF magic_hold THEN ml_scr = ml_scr; ELSE ml_scr = scr; END IF;

	-- ml_turbo: защёлка Турбо
	IF magic_hold THEN ml_turbo = ml_turbo; ELSE ml_turbo = turbo; END IF;

	-- ml_gfx: защёлка Graphic
	IF !magic_hold THEN ml_gfx = graphic; ELSE ml_gfx = ml_gfx; END IF;

	-- ml_blk1: защёлка BLK1
	IF !magic_hold THEN ml_blk1 = blk1; ELSE ml_blk1 = ml_blk1; END IF;

	-- выходы модуля
	o_magic_hold = magic_hold;
	o_dos_act = dos_act;
	o_ml_sys[] = ml_sys[];
	o_ml_sm[] = ml_sm[];
	o_ml_blkpk1 = ml_blkpk1;
	o_ml_scr = ml_scr;
	o_ml_turbo = ml_turbo;
	o_ml_gfx = ml_gfx;
	o_ml_blk1 = ml_blk1;
END;
