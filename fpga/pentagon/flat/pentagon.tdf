	lc1_b12 : LCELL;
	lc2_b12 : DFF;
	lc3_b12 : LCELL;
	lc4_b12 : DFF;
	lc5_b12 : LCELL;
	lc6_b12 : DFF;
	lc1_b13 : DFF;
	lc2_b13 : DFF;
	lc3_b13 : DFF;
	lc4_b13 : DFF;
	lc5_b13 : DFF;
	lc1_b14 : LCELL;
	lc2_b14 : LCELL;
	lc3_b14 : LCELL;
	lc4_b14 : DFF;
	lc8_b14 : LCELL;
	lc1_b15 : DFF;
	lc2_b15 : LCELL;
	lc3_b15 : LCELL;
	lc4_b15 : LCELL;
	lc5_b15 : DFF;
	lc1_b16 : LCELL;
	lc2_b16 : DFF;
	lc3_b16 : DFF;
	lc4_b16 : DFF;
	lc5_b16 : DFF;
	lc6_b16 : LCELL;
	lc1_b17 : LCELL;
	lc2_b17 : LCELL;
	lc3_b17 : DFF;
	lc4_b17 : DFF;
	lc5_b17 : LCELL;
	lc7_b17 : DFF;
	lc1_b18 : LCELL;
	lc2_b18 : DFF;
	lc4_b18 : DFF;
	lc6_b18 : LCELL;
	lc8_b18 : LCELL;
	lc1_b19 : DFF;
	lc2_b19 : LCELL;
	lc4_b19 : DFF;
	lc6_b19 : DFF;
	lc7_b19 : LCELL;
	lc1_b20 : LCELL;
	lc2_b20 : LCELL;
	lc3_b20 : LCELL;
	lc4_b20 : LCELL;
	lc5_b20 : DFF;
	lc6_b20 : LCELL;
	lc8_b20 : LCELL;
	lc1_b21 : LCELL;
	lc2_b21 : DFF;
	lc3_b21 : DFF;
	lc4_b21 : LCELL;
	lc5_b21 : LCELL;
BEGIN
	G = lc1_b11;	-- pin 1 VIO40, slow slew
	DB7_tri.in = lc1_b10;
	DB7_tri.oe = lc1_a5;	-- OE via peripheral line POE0
	DB7 = DB7_tri.out;	-- pin 2 VIO36, slow slew
	R = lc1_b8;	-- pin 3 VIO28, slow slew
	DB6_tri.in = lc1_b7;
	DB6_tri.oe = lc1_a5;	-- OE via peripheral line POE0
	DB6 = DB6_tri.out;	-- pin 4 VIO24, slow slew
	DB5_tri.in = lc1_a6;
	DB5_tri.oe = lc1_a5;	-- OE via peripheral line POE0
	DB5 = DB5_tri.out;	-- pin 6 VIO20, slow slew
	DB4_tri.in = lc1_a4;
	DB4_tri.oe = lc1_a5;	-- OE via peripheral line POE0
	DB4 = DB4_tri.out;	-- pin 7 VIO12, slow slew
	DB3_tri.in = lc1_b3;
	DB3_tri.oe = lc1_a5;	-- OE via peripheral line POE0
	DB3 = DB3_tri.out;	-- pin 8 VIO8, slow slew
	DB2_tri.in = lc1_b2;
	DB2_tri.oe = lc1_a5;	-- OE via peripheral line POE0
	DB2 = DB2_tri.out;	-- pin 9 VIO4, slow slew
	DB1_tri.in = lc1_a2;
	DB1_tri.oe = lc1_a5;	-- OE via peripheral line POE0
	DB1 = DB1_tri.out;	-- pin 13 HIO0, slow slew
	DB0_tri.in = lc2_a14;
	DB0_tri.oe = lc1_a5;	-- OE via peripheral line POE0
	DB0 = DB0_tri.out;	-- pin 14 HIO2, slow slew
	MA0 = lc1_a3;	-- pin 15 HIO4, slow slew
	MA1 = lc4_a3;	-- pin 16 HIO6, slow slew
	MA2 = lc7_a21;	-- pin 18 HIO8, slow slew
	MA3 = lc7_a7;	-- pin 19 HIO10, slow slew
	MA4 = lc6_a21;	-- pin 20 HIO12, slow slew
	MA5 = lc6_a7;	-- pin 21 HIO14, slow slew
	MA6 = lc3_b5;	-- pin 22 HIO16, slow slew
	MA7 = lc2_b5;	-- pin 23 HIO18, slow slew
	MA8 = lc1_b20;	-- pin 24 HIO20, slow slew
	MA9 = lc3_b12;	-- pin 25 HIO22, slow slew
	RAS_n = lc6_b19;	-- pin 27 HIO24, slow slew
	CAS0_n = lc5_b6;	-- pin 28 HIO26, slow slew
	CAS1 = lc6_b4;	-- pin 29 HIO28, slow slew
	WE_n = !lc6_b5;	-- pin 30 HIO30, slow slew
	WAIT_n = lc1_b9;	-- pin 41 VIO35, slow slew
	RAM_n = !lc1_a17;	-- pin 48 VIO67, slow slew
	CLKCPU = !lc2_b19;	-- pin 49 VIO75, slow slew
	EBUF = lc2_b20;	-- pin 50 VIO79, slow slew
	INT = !lc2_b21;	-- pin 51 VIO83, slow slew
	TRBB_tri.in = lc5_b7;
	TRBB_tri.oe = lc1_b21;	-- OE via peripheral line POE1
	TRBB = TRBB_tri.out;	-- pin 55 HIO31, slow slew
	WRBUF = lc8_b20;	-- pin 58 HIO25, slow slew
	RDR_n = lc1_a19;	-- pin 78 VIO72, slow slew
	WROUT_n = lc1_a18;	-- pin 79 VIO68, slow slew
	VS = !lc2_a16;	-- pin 81 VIO60, slow slew
	SYNC = lc1_a15;	-- pin 82 VIO56, slow slew
	I = lc1_b14;	-- pin 83 VIO52, slow slew
	B = lc1_b12;	-- pin 84 VIO44, slow slew
	-- LC1_A1 LUT 22E2
	lc1_a1 = (A7 & !lc3_b3)
		# (lc3_b3 & lc3_a20 & !lc8_a13);
	-- LC2_A1 LUT F0CC
	lc2_a1.d = (lc2_a1 & !lc6_a15)
		# (DB6 & lc6_a15);
	lc2_a1.clk = lc1_b16;
	lc2_a1.clrn = RESET;
	-- LC3_A1 LUT F0CC
	lc3_a1.d = (lc3_a1 & !lc6_a15)
		# (DB5 & lc6_a15);
	lc3_a1.clk = lc1_b16;
	lc3_a1.clrn = RESET;
	-- LC5_A1 LUT F0CC
	lc5_a1.d = (lc5_a1 & !lc6_a15)
		# (DB4 & lc6_a15);
	lc5_a1.clk = lc1_b16;
	lc5_a1.clrn = RESET;
	-- LC7_A1 LUT F0CC
	lc7_a1.d = (lc7_a1 & !lc6_a15)
		# (DB0 & lc6_a15);
	lc7_a1.clk = lc1_b16;
	lc7_a1.clrn = RESET;
	-- LC8_A1 LUT F0CC
	lc8_a1.d = (lc8_a1 & !lc6_a15)
		# (DB3 & lc6_a15);
	lc8_a1.clk = lc1_b16;
	lc8_a1.clrn = RESET;
	-- LC1_A2 LUT CCCA
	lc1_a2 = (lc2_a5 & !lc4_a10 & !lc6_a15)
		# (lc2_a2 & lc4_a10)
		# (lc2_a2 & lc6_a15);
	-- LC2_A2 LUT CCF0
	lc2_a2 = (lc6_a2 & !lc6_a15)
		# (lc6_a8 & lc6_a15);
	-- LC3_A2 LUT CFC0
	lc3_a2.d = (lc3_a2 & lc7_a18)
		# (!lc7_a18 & DB3);
	lc3_a2.clk = !lc5_b4;
	-- LC4_A2 LUT CCF0
	lc4_a2 = (lc5_a2 & !lc3_b3)
		# (lc3_a2 & lc3_b3);
	-- LC5_A2 LUT 80A2
	lc5_a2 = (lc8_b14 & !lc1_b18 & !lc6_a8)
		# (lc8_b14 & lc1_b18 & lc2_a13);
	-- LC6_A2 LUT FC0C
	lc6_a2 = (lc3_a2 & !lc5_a14)
		# (lc5_a14 & lc6_a2);
	-- LC1_A3 LUT FEF0
	lc1_a3 = lc5_a3
		# (lc7_b17 & lc7_a3)
		# (lc8_b5 & lc7_a3);
	-- LC2_A3 LUT CCF0
	lc2_a3 = (A1 & !lc8_b5)
		# (lc6_b18 & lc8_b5);
	-- LC3_A3 LUT FC0C
	lc3_a3 = (lc4_b17 & !lc8_b5)
		# (lc8_b5 & lc3_a11);
	-- LC4_A3 LUT 22E2
	lc4_a3 = (lc2_a3 & !lc3_b3)
		# (lc3_b3 & lc3_a3 & !lc8_a13);
	-- LC5_A3 LUT 00E2
	lc5_a3 = (A0 & !lc8_b5 & !lc3_b3)
		# (lc8_b5 & lc6_a3 & !lc3_b3);
	-- LC6_A3 LUT E6C4
	lc6_a3 = (!lc8_b14 & lc1_b18)
		# (lc1_b18 & lc6_a9)
		# (lc8_b14 & !lc1_b18 & lc4_a13);
	-- LC7_A3 LUT 00F0
	lc7_a3 = lc3_b3 & !lc8_a13;
	-- LC1_A4 LUT CCCA
	lc1_a4 = (lc3_a4 & !lc4_a10 & !lc6_a15)
		# (lc2_a4 & lc4_a10)
		# (lc2_a4 & lc6_a15);
	-- LC2_A4 LUT CCF0
	lc2_a4 = (lc5_a6 & !lc6_a15)
		# (lc5_a1 & lc6_a15);
	-- LC3_A4 LUT FB08
	lc3_a4 = (lc5_a4 & lc8_a21 & !lc3_a7)
		# (!lc8_a21 & lc7_a4)
		# (lc3_a7 & lc7_a4);
	-- LC4_A4 LUT F303
	lc4_a4.d = (!MG & !lc5_a8)
		# (lc5_a8 & lc4_a4);
	lc4_a4.clk = lc5_a15;
	lc4_a4.clrn = lc1_a19;
	-- LC5_A4 LUT AAAA
	lc5_a4.d = MD4;
	lc5_a4.clk = !lc8_b8;
	-- LC6_A4 LUT AAAA
	lc6_a4.d = MD5;
	lc6_a4.clk = !lc8_b8;
	-- LC7_A4 LUT FC30
	lc7_a4 = (!lc5_a14 & lc7_a19)
		# (lc5_a14 & lc7_a4);
	-- LC1_A5 LUT 5504
	lc1_a5 = (!RD_n & lc8_a21 & !lc3_a7)
		# (!RD_n & lc3_a5);
	-- LC2_A5 LUT FB08
	lc2_a5 = (lc5_a5 & lc8_a21 & !lc3_a7)
		# (!lc8_a21 & lc6_a5)
		# (lc3_a7 & lc6_a5);
	-- LC3_A5 LUT F2F0
	lc3_a5 = lc4_a5
		# (lc6_b18 & !lc4_b7 & lc2_a18);
	-- LC4_A5 LUT FFF0
	lc4_a5 = lc4_a10
		# lc6_a15;
	-- LC5_A5 LUT AAAA
	lc5_a5.d = MD1;
	lc5_a5.clk = !lc8_b8;
	-- LC6_A5 LUT FC30
	lc6_a5 = (!lc5_a14 & lc2_a13)
		# (lc5_a14 & lc6_a5);
	-- LC1_A6 LUT CCCA
	lc1_a6 = (lc2_a6 & !lc4_a10 & !lc6_a15)
		# (lc4_a6 & lc4_a10)
		# (lc4_a6 & lc6_a15);
	-- LC2_A6 LUT FB08
	lc2_a6 = (lc6_a4 & lc8_a21 & !lc3_a7)
		# (!lc8_a21 & lc6_a6)
		# (lc3_a7 & lc6_a6);
	-- LC3_A6 LUT 1E3C
	lc3_a6.d = (lc8_a20 & !lc3_a6)
		# (!lc8_a20 & lc3_a6 & !lc7_a20)
		# (!lc4_a16 & !lc8_a20 & lc3_a6)
